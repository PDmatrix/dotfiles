#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
target_dir=${STOW_TARGET:-"$HOME"}
default_packages=(atuin ghostty herdr pi starship zsh)
server_packages=(atuin herdr pi starship zsh)
packages=()
profile=''

usage() {
  cat <<EOF
Usage: ./bootstrap [--profile desktop|server] [package ...]

With no arguments, the desktop profile is used. Package arguments select only
those packages. When --profile is supplied, any package arguments are added to
that profile.

Profiles:
  desktop  ${default_packages[*]}
  server   ${server_packages[*]}
EOF
}

while (($# > 0)); do
  case $1 in
    --profile)
      if (($# < 2)); then
        printf '%s\n' 'Missing profile name after --profile.' >&2
        exit 2
      fi
      profile=$2
      shift 2
      ;;
    --profile=*)
      profile=${1#*=}
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      packages+=("$@")
      break
      ;;
    -*)
      printf 'Unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      packages+=("$1")
      shift
      ;;
  esac
done

if [[ -n "$profile" ]]; then
  case $profile in
    desktop) packages=("${default_packages[@]}" "${packages[@]}") ;;
    server) packages=("${server_packages[@]}" "${packages[@]}") ;;
    *)
      printf 'Unknown profile: %s\n' "$profile" >&2
      usage >&2
      exit 2
      ;;
  esac
elif ((${#packages[@]} == 0)); then
  profile=desktop
  packages=("${default_packages[@]}")
fi

# Avoid passing duplicate packages when one is both in a profile and explicit.
selected_packages=()
for package in "${packages[@]}"; do
  already_selected=false
  for selected in "${selected_packages[@]}"; do
    if [[ "$selected" == "$package" ]]; then
      already_selected=true
      break
    fi
  done
  [[ "$already_selected" == true ]] || selected_packages+=("$package")
done
packages=("${selected_packages[@]}")

if ((${#packages[@]} == 0)); then
  printf '%s\n' 'No packages selected.' >&2
  exit 2
fi

for package in "${packages[@]}"; do
  if [[ ! -d "$repo_dir/$package" ]]; then
    printf 'Unknown package: %s\n' "$package" >&2
    exit 1
  fi
done

if [[ -n "$profile" ]]; then
  printf 'Using %s profile: %s\n' "$profile" "${packages[*]}"
fi

package_is_selected() {
  local wanted=$1 selected
  for selected in "${packages[@]}"; do
    [[ "$selected" == "$wanted" ]] && return 0
  done
  return 1
}

arch_packages=()
add_arch_package() {
  local wanted=$1 existing
  for existing in "${arch_packages[@]}"; do
    [[ "$existing" == "$wanted" ]] && return
  done
  arch_packages+=("$wanted")
}

while IFS= read -r line || [[ -n "$line" ]]; do
  line=${line%%#*}
  read -r owner dependency extra <<< "$line"
  [[ -z "${owner:-}" ]] && continue

  if [[ -z "${dependency:-}" || -n "${extra:-}" ]]; then
    printf 'Invalid entry in %s: %s\n' "$repo_dir/packages.arch" "$line" >&2
    exit 1
  fi
  if [[ "$owner" != '@bootstrap' && ! -d "$repo_dir/$owner" ]]; then
    printf 'Unknown package in %s: %s\n' "$repo_dir/packages.arch" "$owner" >&2
    exit 1
  fi
  if [[ "$owner" == '@bootstrap' ]] || package_is_selected "$owner"; then
    add_arch_package "$dependency"
  fi
done < "$repo_dir/packages.arch"

if command -v pacman >/dev/null 2>&1; then
  missing_packages=()
  while IFS= read -r package; do
    [[ -n "$package" ]] && missing_packages+=("$package")
  done < <(pacman -T "${arch_packages[@]}" 2>/dev/null || true)

  if ((${#missing_packages[@]} > 0)); then
    printf 'Installing missing Arch packages: %s\n' "${missing_packages[*]}"
    if ((EUID == 0)); then
      pacman -S --needed "${missing_packages[@]}"
    elif command -v sudo >/dev/null 2>&1; then
      sudo pacman -S --needed "${missing_packages[@]}"
    else
      printf 'sudo is required to install missing packages: %s\n' "${missing_packages[*]}" >&2
      exit 1
    fi
  fi
fi

if ! command -v stow >/dev/null 2>&1; then
  cat >&2 <<EOF
GNU Stow is required but is not installed.

Install the @bootstrap dependencies listed in:
  $repo_dir/packages.arch

Then run ./bootstrap again.
EOF
  exit 1
fi

missing_external_packages=()
missing_external_commands=()
external_dependency_available() {
  local command_name=$1
  command -v "$command_name" >/dev/null 2>&1 ||
    [[ -x "$HOME/.local/bin/$command_name" ]] ||
    [[ -x "$HOME/.local/share/pi-node/current/bin/$command_name" ]]
}

while IFS='|' read -r owner command_name install_command || [[ -n "${owner:-}" ]]; do
  [[ -z "${owner:-}" || "$owner" == \#* ]] && continue
  if [[ -z "${command_name:-}" || -z "${install_command:-}" ]]; then
    printf 'Invalid entry in %s for package %s\n' "$repo_dir/packages.external" "$owner" >&2
    exit 1
  fi
  if [[ ! -d "$repo_dir/$owner" ]]; then
    printf 'Unknown package in %s: %s\n' "$repo_dir/packages.external" "$owner" >&2
    exit 1
  fi
  if package_is_selected "$owner" && ! external_dependency_available "$command_name"; then
    missing_external_packages+=("$owner")
    missing_external_commands+=("$install_command")
  fi
done < "$repo_dir/packages.external"

state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/dotfiles
backup_root=$state_dir/backups/$(date +%Y%m%d-%H%M%S)
backed_up=false

# Stow refuses to replace ordinary files. Preserve each conflicting managed file
# before linking; unrelated files under the same directories remain untouched.
for package in "${packages[@]}"; do
  while IFS= read -r -d '' source; do
    relative=${source#"$repo_dir/$package/"}
    target=$target_dir/$relative

    if [[ -L "$target" ]] && [[ "$(readlink -f -- "$target" 2>/dev/null || true)" == "$(readlink -f -- "$source")" ]]; then
      continue
    fi

    if [[ -e "$target" || -L "$target" ]]; then
      mkdir -p -- "$backup_root/$(dirname -- "$relative")"
      mv -- "$target" "$backup_root/$relative"
      printf 'Backed up %s\n' "$target"
      backed_up=true
    fi
  done < <(find "$repo_dir/$package" -type f ! -name '.stow-local-ignore' -print0)
done

stow --dir="$repo_dir" --target="$target_dir" --no-folding --stow "${packages[@]}"

printf 'Stowed: %s\n' "${packages[*]}"
if [[ -n "$profile" ]]; then
  mkdir -p -- "$state_dir"
  printf '%s\n' "$profile" > "$state_dir/profile"
  printf 'Active profile: %s\n' "$profile"
fi
if [[ "$backed_up" == true ]]; then
  printf 'Backups: %s\n' "$backup_root"
fi

if ((${#missing_external_packages[@]} > 0)); then
  printf '\nThe following selected tools are not installed. Review and run their installer:\n'
  for ((i = 0; i < ${#missing_external_packages[@]}; i++)); do
    printf '  %s:\n    %s\n' "${missing_external_packages[i]}" "${missing_external_commands[i]}"
  done
fi
