# Arch Linux dependencies, scoped to the Stow package that uses them.
# Format: <stow-package|@bootstrap> <pacman-package>
# Keep one dependency per line. @bootstrap entries are always required.
@bootstrap git
@bootstrap stow
atuin atuin
ghostty ghostty
starship starship
zsh zsh
zsh bat
zsh eza
zsh zsh-autosuggestions
zsh zsh-syntax-highlighting
